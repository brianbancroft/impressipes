{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": ["default", "!{projectRoot}/**/*_test.go", "!{projectRoot}/**/*.spec.*"]
  },
  "targetDefaults": {
    "build": { "dependsOn": ["^build"], "inputs": ["production", "^production"], "cache": true },
    "test": { "inputs": ["default"], "cache": true },
    "lint": { "inputs": ["default"], "cache": true },
    "typecheck": { "inputs": ["default"], "cache": true }
  }
}
